# Smart Patient Frontend Environment Variables
# In local development: leave blank (Vite dev server proxies /api to http://localhost:8080)
# In production on Vercel: Set to your public Spring Boot backend URL, for example:
# VITE_API_URL=https://smart-patient-backend.onrender.com
# (VITE_API_BASE_URL is also supported as an alias)
VITE_API_URL=

